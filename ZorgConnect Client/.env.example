# ── React app (Vite build-time variable) ─────────────────────────────────────
# This variable is embedded into the JavaScript bundle at build time by Vite.
# It MUST be set wherever the app is built (locally in .env, or in the Netlify
# UI under Site settings → Environment variables → Scope: Builds).
#
# Option A – Netlify deployment (recommended):
#   Set VITE_DATABASE_URL=/.netlify/functions/database in your Netlify env vars
#   (Scope: Builds).  The app will then call the bundled serverless function.
#   NOTE: The code also falls back to this value automatically, so setting this
#   variable is optional if you deploy to Netlify.
VITE_DATABASE_URL=/.netlify/functions/database
#
# Option B – local development with `netlify dev`:
#   Run `npx netlify dev` instead of `npm run dev`.  Netlify CLI starts Vite
#   AND the functions together on http://localhost:8888, so the relative URL
#   above (/.netlify/functions/database) works automatically.
#
# Option C – custom PHP server (legacy):
#   Upload src/Database/database.php to a PHP-capable host and set:
# VITE_DATABASE_URL=https://your-php-host.example.com/database.php

# ── Netlify serverless function (netlify/functions/database.mjs) ─────────────
# These variables are used by the serverless function at runtime.
# Set them in Netlify UI → Site settings → Environment variables
# (Scope: Functions, Runtime – exactly as shown in your DB_PASS screenshot).
#
# For local development with `netlify dev`, copy this file to .env and fill in:
DB_USER=db46374
DB_PASS=
