# URL of the database API endpoint.
#
# Option A – Netlify deployment (recommended, no separate PHP host needed):
#   Deploy this project to Netlify (free tier) and set:
VITE_DATABASE_URL=/.netlify/functions/database
#
# Option B – local development with `netlify dev`:
#   Run `npx netlify dev` instead of `npm run dev`.  Netlify CLI starts Vite
#   AND the functions together on http://localhost:8888, so the relative URL
#   above (/.netlify/functions/database) works automatically.
#
# Option C – custom PHP server (legacy):
#   Upload src/Database/database.php to a PHP-capable host and set:
# VITE_DATABASE_URL=https://your-php-host.example.com/database.php
